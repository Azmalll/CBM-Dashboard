# =========================================================
# 1. Build frontend assets
# =========================================================
FROM node:22-alpine AS assets

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build


# =========================================================
# 2. Install PHP dependencies
# =========================================================
FROM composer:2 AS vendor

WORKDIR /app

COPY composer.json composer.lock ./

RUN composer install \
    --no-dev \
    --prefer-dist \
    --no-interaction \
    --no-progress \
    --optimize-autoloader \
    --no-scripts


# =========================================================
# 3. Runtime Laravel
# =========================================================
FROM php:8.3-cli-bookworm

WORKDIR /var/www/html


# =========================================================
# 3A. System dependencies + PHP extensions
# =========================================================
RUN apt-get update && apt-get install -y \
    libzip-dev \
    libicu-dev \
    libonig-dev \
    libpng-dev \
    libjpeg62-turbo-dev \
    libfreetype6-dev \
    libssl-dev \
    libcrypt-dev \
    unzip \
    git \
    curl \
    ca-certificates \
    && docker-php-ext-configure gd \
        --with-freetype \
        --with-jpeg \
    && docker-php-ext-install \
        pdo_mysql \
        mbstring \
        bcmath \
        intl \
        zip \
        gd \
    && rm -rf /var/lib/apt/lists/*


# =========================================================
# 3B. Verify PHP runtime capabilities
#     Bcrypt MUST work before deployment continues
# =========================================================
RUN php -r '\
    echo "PHP VERSION: ", PHP_VERSION, PHP_EOL; \
    echo "PASSWORD_BCRYPT: ", PASSWORD_BCRYPT, PHP_EOL; \
    $hash = password_hash("deployment-test", PASSWORD_BCRYPT, ["cost" => 12]); \
    if ($hash === false) { \
        fwrite(STDERR, "ERROR: Bcrypt hashing is NOT supported in this PHP runtime.", PHP_EOL); \
        exit(1); \
    } \
    echo "BCRYPT TEST: OK", PHP_EOL; \
    echo "HASH: ", $hash, PHP_EOL; \
'


# =========================================================
# 4. Copy Laravel application
# =========================================================
COPY . .


# =========================================================
# 5. Copy Composer dependencies
# =========================================================
COPY --from=vendor /app/vendor ./vendor


# =========================================================
# 6. Copy compiled frontend assets
# =========================================================
COPY --from=assets /app/public/build ./public/build


# =========================================================
# 7. Laravel writable directories
# =========================================================
RUN mkdir -p \
    storage/framework/cache \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    bootstrap/cache


RUN chmod -R 775 storage bootstrap/cache


# =========================================================
# 8. Clear old Laravel caches
# =========================================================
RUN php artisan optimize:clear


# =========================================================
# 9. Generate optimized package discovery
# =========================================================
RUN php artisan package:discover --ansi


# =========================================================
# 10. Vercel runtime
# =========================================================
CMD ["sh", "-c", "php artisan serve --host=0.0.0.0 --port=${PORT:-80}"]